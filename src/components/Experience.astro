---
const jobs = [
  {
    company: "PISCES International",
    title: "SOC Analyst",
    timeframe: "Jan 2026 — Jun 2026",
    url: "https://pisces-intl.org/",
    description:
      "Gained operational experience analyzing real-time security events collected from critical infrastructure organizations. Built pisces-scripts, a custom tooling suite leveraging Kibana, OpenSearch Dashboards, and the ElasticSearch/OpenSearch APIs to streamline SOC workflows and automate event triage.",
    tech: ["Kibana", "OpenSearch", "ElasticSearch", "Python", "SIEM", "Bash", "REST APIs"],
  },
  {
    company: "Bellevue College InfoSec Club",
    title: "President",
    timeframe: "Sep 2024 — Mar 2026",
    url: "https://bcinfosec.club",
    description:
      "Led weekly hands-on labs for 20+ members covering penetration testing, network exploitation, and privilege escalation. Competed in PRCCDC 2025, defending enterprise networks against professional red team attacks. Built a virtualized lab using Proxmox/Ludus for 30+ students and produced educational YouTube content on real-world exploits.",
    tech: ["Hugo", "HTML/CSS", "Linux", "Cybersecurity", "Homelab", "Ludus", "Proxmox", "Leadership", "Teaching"],
  },
  {
    company: "Dutch Bros Coffee",
    title: "Barista",
    timeframe: "Mar 2024 — May 2026",
    url: "https://www.dutchbros.com/",
    description:
      "Prepared drinks, provided customer service in a fast-paced environment, and supported team operations.",
    tech: [],
  },
  {
    company: "Various",
    title: "Prior Roles",
    timeframe: "Jan 2020 — Jul 2023",
    url: "",
    description:
      "Sales Associate at Target (2020–2021), Apprentice Carpenter at Littell House Construction (2022), and Barista at Beans & Brews (2023). Developed customer service, teamwork, and hands-on trade skills across retail, construction, and food service.",
    tech: [],
  },
  {
    company: "Microsoft Research",
    title: "Research Intern",
    timeframe: "Jul 2018 — Aug 2018",
    url: "https://www.microsoft.com/en-us/research/",
    description:
      "Developed an Arduino-based assistive device for visually impaired users. Collected and formatted gesture data for a machine learning prototype.",
    tech: ["Arduino", "Python", "Embedded Systems", "Machine Learning"],
  },
];
const education = [
  {
    school: "Bellevue College",
    degree: "Bachelor of Applied Science in Cybersecurity",
    timeframe: "Mar 2024 — Dec 2026",
    location: "Bellevue, WA",
    url: "https://www.bellevuecollege.edu/cybersecurity/",
    gpa: "3.98 / 4.0",
    relevantCourses: ["Python", "Networking Series (CCNA)", "Intro to AWS"],
  },
  {
    school: "University of Washington — Seattle",
    degree: "General Education",
    timeframe: "Sep 2020 — Dec 2022",
    location: "Seattle, WA",
    url: "https://www.washington.edu/",
    gpa: "3.7 / 4.0",
    relevantCourses: ["Java I", "Java II"],
  },
];
---

<section id="experience" class="experience-section">
  <h2 class="experience-heading">Work Experience</h2>

  <ol class="experience-list">
    {jobs.map(job => (
      <li>
        <div class="job-entry">
          <time class="job-time">
            {job.timeframe}
          </time>
          <div class="job-details">
            <h3 class="job-title">
              {job.url ? (
                <a href={job.url} target="_blank" rel="noopener noreferrer" class="job-link group">
                  {job.title} · <span class="job-company">{job.company}</span>
                </a>
              ) : (
                <span class="job-link">
                  {job.title} · <span class="job-company">{job.company}</span>
                </span>
              )}
            </h3>
            <p class="job-description">{job.description}</p>
            <ul class="job-tech-list">
              {job.tech.map(t => (
                <li>
                  <span class="job-tech">{t}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <br>
  <h2 class="experience-heading">Education</h2>
  <ol class="experience-list">
    {education.map(school => (
      <li>
        <div class="job-entry">
          <time class="job-time">
            {school.timeframe}
          </time>
          <div class="job-details">
            <h3 class="edu-title">
              <span class="edu-degree">{school.degree}</span>
              <a href={school.url} target="_blank" rel="noopener noreferrer" class="edu-school">
                {school.school}
              </a>
            </h3>
            <p class="job-description">GPA: {school.gpa}</p>
            <ul class="job-tech-list">
              {school.relevantCourses.map(t => (
                <li>
                  <span class="job-tech">{t}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>
